{
  "name": "714-mcp-tool",
  "version": "2.0.0",
  "description": "Zero-config CLI that turns any local repository into a Model Context Protocol (MCP) server for Claude, Cursor, Antigravity, and AI agents.",
  "type": "module",
  "bin": {
    "714-mcp-tool": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Misa714/codebase-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Misa714/codebase-mcp/issues"
  },
  "homepage": "https://github.com/Misa714/codebase-mcp#readme",
  "scripts": {
    "build": "tsc && (chmod +x dist/index.js 2>/dev/null || true)",
    "start": "node ./dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "antigravity",
    "ai",
    "codebase",
    "developer-tools",
    "cli"
  ],
  "author": "lembrox",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "ignore": "^7.0.3",
    "minisearch": "^7.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
